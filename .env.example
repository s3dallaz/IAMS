# OmniRoute API Configuration
# Copy this file to .env and fill in your actual API key.
# `.env` is git-ignored, so your key is never committed.
OMNIROUTE_API_KEY=your_api_key_here

# Optional OmniRoute overrides (defaults mirror opencode.json)
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=kr/claude-sonnet-4.5
# AI_REQUEST_TIMEOUT=30

# Which camera to use: part of its name, ignoring case and spaces.
# Empty: the first camera that is not a phone / virtual one.
# CAMERA_NAME=Brio 100

# Application Settings (optional overrides)
# APP_DEBUG=false
# APP_LOG_LEVEL=INFO